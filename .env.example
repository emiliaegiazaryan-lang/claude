# ==========================================================================
# Контент-конвейер SKEYLO (Telegram-бот)
# Скопируйте этот файл в .env и заполните значения. Файл .env не коммитится.
# ==========================================================================

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ Anthropic (Claude API) - https://platform.claude.com
ANTHROPIC_API_KEY=

# Ключ OpenAI (Whisper API для транскрибации) - https://platform.openai.com
OPENAI_API_KEY=

# Необязательные настройки (значения по умолчанию уже вшиты в код)
# Модель Claude для всех шести агентов
# ANTHROPIC_MODEL=claude-sonnet-4-6
# Температуры агентов
# PARSER_TEMPERATURE=0.2
# CHANNEL_TEMPERATURE=0.6
# EDITOR_TEMPERATURE=0.2
# Пауза после последнего сообщения серии, секунд
# DEBOUNCE_SECONDS=20
# Кому разрешено пользоваться ботом (Telegram user id через запятую).
# Пусто - бот отвечает всем.
# TELEGRAM_ALLOWED_USER_IDS=

# ==========================================================================
# Токены API Wildberries для скрипта wildberries_export.py (не для бота)
# Получить токены: https://seller.wildberries.ru -> Настройки -> Доступ к API
# Токен действителен 180 дней. Храните его в тайне.
# ==========================================================================
WB_STATISTICS_TOKEN=
WB_ANALYTICS_TOKEN=
WB_ADVERTISING_TOKEN=
