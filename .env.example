# Токены API Wildberries для ИП Полынцев Я.
# Получить токены: https://seller.wildberries.ru → Настройки → Доступ к API
#
# Для каждого токена выберите только нужные категории разрешений:
#   WB_STATISTICS_TOKEN  → категория «Статистика»
#   WB_ANALYTICS_TOKEN   → категория «Аналитика»
#   WB_ADVERTISING_TOKEN → категория «Продвижение»
#
# Токен действителен 180 дней. Храните его в тайне!

WB_STATISTICS_TOKEN=ваш_токен_статистики
WB_ANALYTICS_TOKEN=ваш_токен_аналитики
WB_ADVERTISING_TOKEN=ваш_токен_продвижения
